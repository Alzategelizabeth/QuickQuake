{
    // VS Code run/debug configurations for QuickQuake.
    // Each one runs a project's QQ_driver.py; open your own driver and use "Current File".
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "QuickQuake: Pavlof example",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/pavlof_2021/QQ_driver.py",
            "console": "integratedTerminal"
        }
    ]
}
